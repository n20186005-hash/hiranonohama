---
import BaseLayout from '@/components/BaseLayout.astro';
---

<BaseLayout title="ページが見つかりません｜平野の浜" description="指定されたページは見つかりませんでした。" noindex={true}>
  <section class="site-shell grid min-h-[65svh] place-items-center py-20 text-center">
    <div>
      <p class="mincho text-8xl text-lake-200">404</p>
      <h1 class="mt-5 mincho text-3xl tracking-[0.08em]">湖畔の道から外れたようです。</h1>
      <p class="mt-5 text-sm leading-8 text-lake-700">ページが移動したか、アドレスが正しくない可能性があります。</p>
      <a href="/" class="mt-8 inline-flex rounded-full bg-lake-900 px-7 py-3 text-sm font-bold tracking-[0.1em] text-white no-underline">トップへ戻る</a>
    </div>
  </section>
</BaseLayout>
