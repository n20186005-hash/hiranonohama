---
import BaseLayout from '@/components/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Notice from '@/components/Notice.astro';
---

<BaseLayout title="旅の写真カード｜平野の浜" description="写真を端末内で加工し、平野の浜の旅の記念カードとして保存できるローカル画像ツールです。" noindex={false}>
  <PageHero eyebrow="PHOTO CARD" title="旅の一枚に、余韻を添える。" lead="自分で撮った写真に、場所、日付、短い言葉を重ねて縦長の記念カードをつくります。画像処理はすべてブラウザ内。写真は外部へ送信されません。" image="/images/red-fuji.webp" imageAlt="朝の光に染まる富士山" />

  <section class="site-shell py-20 sm:py-28">
    <div class="grid gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:items-start">
      <div class="editorial-card p-6 sm:p-8">
        <h2 class="mincho text-2xl">カードの設定</h2>
        <div class="mt-7 grid gap-5">
          <label class="grid gap-2 text-sm font-bold">
            写真を選ぶ
            <input id="photo-input" type="file" accept="image/*" class="w-full rounded-none border hairline bg-white px-3 py-3 text-sm font-normal file:mr-4 file:rounded-full file:border-0 file:bg-lake-900 file:px-4 file:py-2 file:text-xs file:font-bold file:text-white" />
          </label>
          <label class="grid gap-2 text-sm font-bold">
            大きな言葉
            <input id="title-input" type="text" maxlength="18" value="湖面に映る、旅の記憶。" class="w-full border hairline bg-white px-3 py-3 font-normal" />
          </label>
          <label class="grid gap-2 text-sm font-bold">
            日付
            <span class="flex w-full min-w-0 border hairline bg-white px-3 py-3">
              <input id="date-input" type="date" class="block w-full min-w-0 border-0 bg-transparent p-0 font-normal" />
            </span>
          </label>
          <label class="grid gap-2 text-sm font-bold">
            仕上がり
            <select id="style-input" class="w-full border hairline bg-white px-3 py-3 font-normal">
              <option value="mist">湖霧 — 明るく静か</option>
              <option value="ink">墨景 — 深く端正</option>
              <option value="dawn">朝霞 — やわらかな赤</option>
            </select>
          </label>
          <label class="grid gap-2 text-sm font-bold">
            カード比率
            <select id="ratio-input" class="w-full border hairline bg-white px-3 py-3 font-normal">
              <option value="portrait">縦長 4:5 — SNS投稿向け</option>
              <option value="square">正方形 1:1 — アイコン・投稿向け</option>
              <option value="landscape">横長 3:2 — ポストカード向け</option>
            </select>
          </label>
          <label class="grid gap-2 text-sm font-bold">
            写真と文字の配置
            <select id="layout-input" class="w-full border hairline bg-white px-3 py-3 font-normal">
              <option value="overlay">全面写真 — 写真に文字を重ねる</option>
              <option value="split">写真＋余白 — 情報を下にまとめる</option>
              <option value="frame">余白フレーム — 写真を静かに囲む</option>
            </select>
          </label>

          <fieldset class="mt-1 grid gap-4 border-t hairline pt-5">
            <legend class="pr-3 text-sm font-bold">写真の位置と大きさ</legend>
            <label class="grid gap-2 text-xs font-bold tracking-[0.04em] text-lake-700">
              <span class="flex items-center justify-between"><span>拡大</span><output id="zoom-value" for="zoom-input">100%</output></span>
              <input id="zoom-input" type="range" min="100" max="220" step="1" value="100" class="w-full accent-lake-900" />
            </label>
            <label class="grid gap-2 text-xs font-bold tracking-[0.04em] text-lake-700">
              <span class="flex items-center justify-between"><span>左右位置</span><output id="position-x-value" for="position-x-input">中央</output></span>
              <input id="position-x-input" type="range" min="-100" max="100" step="1" value="0" class="w-full accent-lake-900" />
            </label>
            <label class="grid gap-2 text-xs font-bold tracking-[0.04em] text-lake-700">
              <span class="flex items-center justify-between"><span>上下位置</span><output id="position-y-value" for="position-y-input">中央</output></span>
              <input id="position-y-input" type="range" min="-100" max="100" step="1" value="0" class="w-full accent-lake-900" />
            </label>
            <p id="canvas-help" class="text-xs leading-6 text-lake-600">プレビュー上の写真をドラッグして移動できます。方向キーでも微調整できます。</p>
            <button id="reset-position-button" type="button" class="justify-self-start rounded-full border hairline bg-white px-4 py-2 text-xs font-bold tracking-[0.06em] transition hover:bg-lake-50">位置と拡大をリセット</button>
          </fieldset>

          <button id="download-button" type="button" class="cta-button cta-button--dark mt-2 w-full">PNGで保存</button>
          <p id="tool-status" class="text-xs leading-6 text-lake-600" aria-live="polite">初期画像でプレビューしています。</p>
        </div>
        <div class="mt-7">
          <Notice title="写真はアップロードされません">
            選択した画像は、この端末のブラウザ内でのみ読み込まれます。ページを閉じると、編集状態は残りません。
          </Notice>
        </div>
      </div>

      <div class="lg:sticky lg:top-6">
        <canvas id="photo-canvas" width="1200" height="1500" class="photo-card-canvas mx-auto block w-full max-w-2xl bg-lake-100 shadow-2xl shadow-lake-900/15" aria-label="生成する写真カードのプレビュー。写真部分はドラッグで位置を調整できます。" aria-describedby="canvas-help" tabindex="0"></canvas>
        <p class="mt-3 text-center text-xs text-lake-600"><span id="canvas-size">1200 × 1500 px</span> · 端末内処理</p>
      </div>
    </div>
  </section>

  <script>
    const canvas = document.querySelector('#photo-canvas');
    const photoInput = document.querySelector('#photo-input');
    const titleInput = document.querySelector('#title-input');
    const dateInput = document.querySelector('#date-input');
    const styleInput = document.querySelector('#style-input');
    const ratioInput = document.querySelector('#ratio-input');
    const layoutInput = document.querySelector('#layout-input');
    const zoomInput = document.querySelector('#zoom-input');
    const positionXInput = document.querySelector('#position-x-input');
    const positionYInput = document.querySelector('#position-y-input');
    const zoomValue = document.querySelector('#zoom-value');
    const positionXValue = document.querySelector('#position-x-value');
    const positionYValue = document.querySelector('#position-y-value');
    const resetPositionButton = document.querySelector('#reset-position-button');
    const downloadButton = document.querySelector('#download-button');
    const canvasSize = document.querySelector('#canvas-size');
    const status = document.querySelector('#tool-status');

    if (!(canvas instanceof HTMLCanvasElement)) throw new Error('Canvas not found');
    if (!(photoInput instanceof HTMLInputElement)) throw new Error('Photo input not found');
    if (!(titleInput instanceof HTMLInputElement)) throw new Error('Title input not found');
    if (!(dateInput instanceof HTMLInputElement)) throw new Error('Date input not found');
    if (!(styleInput instanceof HTMLSelectElement)) throw new Error('Style input not found');
    if (!(ratioInput instanceof HTMLSelectElement)) throw new Error('Ratio input not found');
    if (!(layoutInput instanceof HTMLSelectElement)) throw new Error('Layout input not found');
    if (!(zoomInput instanceof HTMLInputElement)) throw new Error('Zoom input not found');
    if (!(positionXInput instanceof HTMLInputElement)) throw new Error('Position X input not found');
    if (!(positionYInput instanceof HTMLInputElement)) throw new Error('Position Y input not found');

    const ctx = canvas.getContext('2d');
    if (!ctx) throw new Error('Canvas context not found');

    const cardSizes = {
      portrait: { width: 1200, height: 1500 },
      square: { width: 1200, height: 1200 },
      landscape: { width: 1500, height: 1000 },
    };

    const image = new Image();
    image.decoding = 'async';
    let objectUrl = '';
    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let dragStartPositionX = 0;
    let dragStartPositionY = 0;

    const today = new Date();
    dateInput.value = [today.getFullYear(), String(today.getMonth() + 1).padStart(2, '0'), String(today.getDate()).padStart(2, '0')].join('-');

    function clamp(value, min, max) {
      return Math.min(max, Math.max(min, value));
    }

    function formatDate(value) {
      if (!value) return '';
      const [year, month, day] = value.split('-');
      return `${year}.${month}.${day}`;
    }

    function getPhotoRect() {
      const width = canvas.width;
      const height = canvas.height;
      if (layoutInput.value === 'split') {
        return { x: 0, y: 0, width, height: Math.round(height * (ratioInput.value === 'landscape' ? 0.62 : 0.66)) };
      }
      if (layoutInput.value === 'frame') {
        const margin = Math.round(Math.min(width, height) * 0.055);
        return {
          x: margin,
          y: margin,
          width: width - margin * 2,
          height: Math.round(height * (ratioInput.value === 'landscape' ? 0.63 : 0.67)),
        };
      }
      return { x: 0, y: 0, width, height };
    }

    function getPlacementMetrics() {
      const photoRect = getPhotoRect();
      const zoom = Number(zoomInput.value) / 100;
      const baseScale = Math.max(photoRect.width / image.naturalWidth, photoRect.height / image.naturalHeight);
      const scale = baseScale * zoom;
      const drawWidth = image.naturalWidth * scale;
      const drawHeight = image.naturalHeight * scale;
      return {
        photoRect,
        drawWidth,
        drawHeight,
        maxShiftX: Math.max(0, (drawWidth - photoRect.width) / 2),
        maxShiftY: Math.max(0, (drawHeight - photoRect.height) / 2),
      };
    }

    function drawPhoto() {
      const metrics = getPlacementMetrics();
      const positionX = Number(positionXInput.value) / 100;
      const positionY = Number(positionYInput.value) / 100;
      const drawX = metrics.photoRect.x + (metrics.photoRect.width - metrics.drawWidth) / 2 + positionX * metrics.maxShiftX;
      const drawY = metrics.photoRect.y + (metrics.photoRect.height - metrics.drawHeight) / 2 + positionY * metrics.maxShiftY;

      ctx.save();
      ctx.beginPath();
      ctx.rect(metrics.photoRect.x, metrics.photoRect.y, metrics.photoRect.width, metrics.photoRect.height);
      ctx.clip();
      ctx.drawImage(image, drawX, drawY, metrics.drawWidth, metrics.drawHeight);
      ctx.restore();
      return metrics.photoRect;
    }

    function applyPhotoTone(photoRect) {
      ctx.save();
      ctx.beginPath();
      ctx.rect(photoRect.x, photoRect.y, photoRect.width, photoRect.height);
      ctx.clip();

      if (styleInput.value === 'ink') {
        ctx.fillStyle = 'rgba(18, 29, 33, 0.34)';
        ctx.fillRect(photoRect.x, photoRect.y, photoRect.width, photoRect.height);
      } else if (styleInput.value === 'dawn') {
        const warm = ctx.createLinearGradient(photoRect.x, photoRect.y, photoRect.x + photoRect.width, photoRect.y + photoRect.height);
        warm.addColorStop(0, 'rgba(189, 103, 90, 0.3)');
        warm.addColorStop(0.65, 'rgba(37, 48, 52, 0.04)');
        warm.addColorStop(1, 'rgba(37, 48, 52, 0.24)');
        ctx.fillStyle = warm;
        ctx.fillRect(photoRect.x, photoRect.y, photoRect.width, photoRect.height);
      } else {
        ctx.fillStyle = 'rgba(238, 243, 242, 0.08)';
        ctx.fillRect(photoRect.x, photoRect.y, photoRect.width, photoRect.height);
      }

      if (layoutInput.value === 'overlay') {
        const gradient = ctx.createLinearGradient(0, canvas.height * 0.42, 0, canvas.height);
        gradient.addColorStop(0, 'rgba(17, 29, 33, 0)');
        gradient.addColorStop(1, 'rgba(17, 29, 33, 0.9)');
        ctx.fillStyle = gradient;
        ctx.fillRect(0, canvas.height * 0.35, canvas.width, canvas.height * 0.65);
      }
      ctx.restore();
    }

    function wrapTitle(text, maxWidth, maxLines) {
      const lines = [];
      let line = '';
      for (const character of text) {
        const test = line + character;
        if (ctx.measureText(test).width > maxWidth && line) {
          lines.push(line);
          line = character;
        } else {
          line = test;
        }
      }
      if (line) lines.push(line);
      if (lines.length > maxLines) {
        const limited = lines.slice(0, maxLines);
        let lastLine = limited[maxLines - 1];
        while (lastLine && ctx.measureText(`${lastLine}…`).width > maxWidth) lastLine = lastLine.slice(0, -1);
        limited[maxLines - 1] = `${lastLine}…`;
        return limited;
      }
      return lines;
    }

    function drawTypography(photoRect) {
      const width = canvas.width;
      const height = canvas.height;
      const unit = Math.min(width, height);
      const margin = Math.round(unit * 0.07);
      const isOverlay = layoutInput.value === 'overlay';
      const title = titleInput.value.trim() || '湖面に映る、旅の記憶。';
      const date = formatDate(dateInput.value);
      const titleFontSize = Math.round(unit * (ratioInput.value === 'landscape' ? 0.052 : 0.057));
      const lineHeight = Math.round(titleFontSize * 1.3);
      const titleMaxWidth = width - margin * 2;

      ctx.save();
      ctx.textAlign = 'left';
      ctx.textBaseline = 'alphabetic';
      ctx.fillStyle = isOverlay ? 'rgba(255,255,255,0.92)' : '#435459';
      ctx.font = `600 ${Math.max(18, Math.round(unit * 0.019))}px sans-serif`;

      const panelTop = photoRect.y + photoRect.height;
      const brandY = isOverlay ? margin + Math.round(unit * 0.025) : panelTop + Math.round(unit * 0.047);
      ctx.fillText('HIRANO NO HAMA', margin, brandY);

      ctx.font = `500 ${Math.max(22, Math.round(unit * 0.025))}px serif`;
      ctx.fillText('山中湖・富士山', margin, brandY + Math.round(unit * 0.043));

      ctx.font = `500 ${titleFontSize}px serif`;
      const maxLines = ratioInput.value === 'landscape' ? 2 : 3;
      const lines = wrapTitle(title, titleMaxWidth, maxLines);
      const metaY = height - margin;
      let titleStartY;

      if (isOverlay) {
        titleStartY = metaY - Math.round(unit * 0.085) - (lines.length - 1) * lineHeight;
        ctx.fillStyle = '#fff';
        ctx.shadowColor = 'rgba(0,0,0,0.42)';
        ctx.shadowBlur = Math.round(unit * 0.018);
      } else {
        titleStartY = brandY + Math.round(unit * 0.1);
        ctx.fillStyle = '#253034';
      }

      lines.forEach((line, index) => ctx.fillText(line, margin, titleStartY + index * lineHeight));
      ctx.shadowBlur = 0;

      ctx.fillStyle = isOverlay ? 'rgba(255,255,255,0.78)' : 'rgba(37,48,52,0.66)';
      ctx.font = `500 ${Math.max(18, Math.round(unit * 0.02))}px sans-serif`;
      ctx.fillText(date, margin, metaY);
      ctx.textAlign = 'right';
      ctx.fillText('LAKE YAMANAKA · YAMANASHI', width - margin, metaY);
      ctx.restore();
    }

    function drawFrame(photoRect) {
      const unit = Math.min(canvas.width, canvas.height);
      ctx.save();
      if (layoutInput.value === 'overlay') {
        const margin = Math.round(unit * 0.048);
        ctx.strokeStyle = 'rgba(255,255,255,0.7)';
        ctx.lineWidth = Math.max(2, Math.round(unit * 0.0016));
        ctx.strokeRect(margin, margin, canvas.width - margin * 2, canvas.height - margin * 2);
      } else if (layoutInput.value === 'frame') {
        ctx.strokeStyle = 'rgba(37,48,52,0.2)';
        ctx.lineWidth = Math.max(2, Math.round(unit * 0.0014));
        ctx.strokeRect(photoRect.x, photoRect.y, photoRect.width, photoRect.height);
      }
      ctx.restore();
    }

    function updateControlLabels() {
      if (zoomValue) zoomValue.textContent = `${zoomInput.value}%`;
      const horizontal = Number(positionXInput.value);
      const vertical = Number(positionYInput.value);
      if (positionXValue) positionXValue.textContent = horizontal === 0 ? '中央' : `${horizontal > 0 ? '右' : '左'} ${Math.abs(horizontal)}%`;
      if (positionYValue) positionYValue.textContent = vertical === 0 ? '中央' : `${vertical > 0 ? '下' : '上'} ${Math.abs(vertical)}%`;
    }

    function resizeCanvas() {
      const selectedSize = cardSizes[ratioInput.value] ?? cardSizes.portrait;
      canvas.width = selectedSize.width;
      canvas.height = selectedSize.height;
      canvas.style.aspectRatio = `${selectedSize.width} / ${selectedSize.height}`;
      if (canvasSize) canvasSize.textContent = `${selectedSize.width} × ${selectedSize.height} px`;
    }

    function draw() {
      if (!image.complete || !image.naturalWidth) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#f8f7f2';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      const photoRect = drawPhoto();
      applyPhotoTone(photoRect);
      drawFrame(photoRect);
      drawTypography(photoRect);
      updateControlLabels();
    }

    function resetPosition() {
      zoomInput.value = '100';
      positionXInput.value = '0';
      positionYInput.value = '0';
      updateControlLabels();
      draw();
    }

    image.addEventListener('load', () => {
      draw();
      if (status) status.textContent = objectUrl ? '選んだ写真を端末内で読み込みました。ドラッグして構図を調整できます。' : '初期画像でプレビューしています。';
    });

    [titleInput, dateInput, styleInput, layoutInput, zoomInput, positionXInput, positionYInput].forEach((element) => {
      element.addEventListener('input', draw);
    });

    ratioInput.addEventListener('input', () => {
      resizeCanvas();
      draw();
    });

    photoInput.addEventListener('change', () => {
      if (!photoInput.files?.[0]) return;
      if (objectUrl) URL.revokeObjectURL(objectUrl);
      objectUrl = URL.createObjectURL(photoInput.files[0]);
      resetPosition();
      image.src = objectUrl;
      if (status) status.textContent = '写真を端末内で読み込んでいます。';
    });

    resetPositionButton?.addEventListener('click', () => {
      resetPosition();
      if (status) status.textContent = '写真の位置と拡大率を初期状態へ戻しました。';
    });

    canvas.addEventListener('pointerdown', (event) => {
      if (!event.isPrimary || !image.naturalWidth) return;
      isDragging = true;
      dragStartX = event.clientX;
      dragStartY = event.clientY;
      dragStartPositionX = Number(positionXInput.value);
      dragStartPositionY = Number(positionYInput.value);
      canvas.setPointerCapture(event.pointerId);
      canvas.classList.add('is-dragging');
    });

    canvas.addEventListener('pointermove', (event) => {
      if (!isDragging) return;
      const bounds = canvas.getBoundingClientRect();
      const metrics = getPlacementMetrics();
      const deltaCanvasX = (event.clientX - dragStartX) * (canvas.width / bounds.width);
      const deltaCanvasY = (event.clientY - dragStartY) * (canvas.height / bounds.height);
      if (metrics.maxShiftX > 0) positionXInput.value = String(Math.round(clamp(dragStartPositionX + deltaCanvasX / metrics.maxShiftX * 100, -100, 100)));
      if (metrics.maxShiftY > 0) positionYInput.value = String(Math.round(clamp(dragStartPositionY + deltaCanvasY / metrics.maxShiftY * 100, -100, 100)));
      draw();
    });

    function stopDragging(event) {
      if (!isDragging) return;
      isDragging = false;
      canvas.classList.remove('is-dragging');
      if (canvas.hasPointerCapture(event.pointerId)) canvas.releasePointerCapture(event.pointerId);
      if (status) status.textContent = '写真の位置を調整しました。';
    }

    canvas.addEventListener('pointerup', stopDragging);
    canvas.addEventListener('pointercancel', stopDragging);

    canvas.addEventListener('keydown', (event) => {
      const step = event.shiftKey ? 15 : 4;
      let handled = true;
      if (event.key === 'ArrowLeft') positionXInput.value = String(clamp(Number(positionXInput.value) - step, -100, 100));
      else if (event.key === 'ArrowRight') positionXInput.value = String(clamp(Number(positionXInput.value) + step, -100, 100));
      else if (event.key === 'ArrowUp') positionYInput.value = String(clamp(Number(positionYInput.value) - step, -100, 100));
      else if (event.key === 'ArrowDown') positionYInput.value = String(clamp(Number(positionYInput.value) + step, -100, 100));
      else handled = false;
      if (!handled) return;
      event.preventDefault();
      draw();
    });

    downloadButton?.addEventListener('click', () => {
      draw();
      const link = document.createElement('a');
      link.download = `hirano-no-hama-photo-card-${ratioInput.value}.png`;
      link.href = canvas.toDataURL('image/png');
      link.click();
      if (status) status.textContent = '現在のレイアウトでPNGを保存しました。';
    });

    window.addEventListener('beforeunload', () => {
      if (objectUrl) URL.revokeObjectURL(objectUrl);
    });

    resizeCanvas();
    updateControlLabels();
    image.src = '/images/hero.webp';
  </script>

  <style>
    .photo-card-canvas {
      cursor: grab;
      touch-action: none;
      transition: aspect-ratio 220ms ease;
    }

    .photo-card-canvas.is-dragging {
      cursor: grabbing;
    }
  </style>
</BaseLayout>
