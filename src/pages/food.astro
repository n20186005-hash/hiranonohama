---
import BaseLayout from '@/components/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionIntro from '@/components/SectionIntro.astro';
import Notice from '@/components/Notice.astro';
import { foodSpots } from '@/data/content';
---

<BaseLayout title="平野の浜周辺の食事｜山中湖" description="平野の浜周辺で立ち寄りやすいそば、カフェ、ほうとう、朝食の候補を、旅の時間帯別に紹介します。">
  <PageHero eyebrow="FOOD" title="景色のあとに、山梨を味わう。" lead="平野の浜の周辺には、手打そば、湖畔のカフェ、ほうとう、早朝撮影後の朝食候補があります。徒歩と短いドライブを分けて考えると選びやすくなります。" image="/images/sunflower-fuji.webp" imageAlt="夏の山中湖周辺と富士山" />

  <section class="site-shell py-24 sm:py-32">
    <SectionIntro eyebrow="NEARBY TABLE" title="旅の時間に合う店を選ぶ" copy="ここではメニュー傾向と立ち寄り方を紹介します。観光地の営業時間、定休日、年齢条件、予約要否は変わるため、出発当日に店頭情報を確認してください。" />
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {foodSpots.map((spot, index) => (
        <article class="editorial-card flex min-h-80 flex-col p-7">
          <div class="flex items-center justify-between gap-4">
            <span class="rounded-full bg-lake-100 px-3 py-1 text-xs font-bold text-lake-700">{spot.category}</span>
            <span class="mincho text-2xl text-lake-300">0{index + 1}</span>
          </div>
          <h2 class="mt-7 mincho text-2xl leading-9">{spot.name}</h2>
          <p class="mt-3 text-xs font-bold tracking-[0.08em] text-dawn-600">{spot.access}</p>
          <p class="mt-5 flex-1 text-sm leading-7 text-lake-700">{spot.description}</p>
          <p class="mt-6 border-t hairline pt-4 text-xs text-lake-600">確認：{spot.note}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-lake-900 py-24 text-white sm:py-32">
    <div class="site-shell">
      <SectionIntro eyebrow="BY MOMENT" title="時間帯から決める" />
      <div class="grid gap-8 lg:grid-cols-3">
        <article class="border-t border-white/25 pt-6">
          <p class="mincho text-4xl text-lake-300">朝</p>
          <h2 class="mt-4 mincho text-2xl">撮影後、温かい朝食へ</h2>
          <p class="mt-4 text-sm leading-8 text-lake-200">早朝営業の有無を確認し、長池方面や宿の朝食も選択肢に。日の出直後は営業前の店が多い点に注意します。</p>
        </article>
        <article class="border-t border-white/25 pt-6">
          <p class="mincho text-4xl text-lake-300">昼</p>
          <h2 class="mt-4 mincho text-2xl">そば、カフェ、ほうとう</h2>
          <p class="mt-4 text-sm leading-8 text-lake-200">徒歩圏はそばやカフェを中心に。郷土料理まで選びたい日は、山中地区へ移動する計画にします。</p>
        </article>
        <article class="border-t border-white/25 pt-6">
          <p class="mincho text-4xl text-lake-300">夜</p>
          <h2 class="mt-4 mincho text-2xl">予約と帰路を先に確認</h2>
          <p class="mt-4 text-sm leading-8 text-lake-200">夕食営業は予約制や季節休業もあります。公共交通利用では、最終便の時刻を食事より先に決めます。</p>
        </article>
      </div>
      <div class="mt-12">
        <Notice title="飲食情報の扱い">
          本サイトは予約代行を行いません。価格、営業日時、提供メニュー、入店条件は各店舗の当日案内を優先してください。
        </Notice>
      </div>
    </div>
  </section>
</BaseLayout>
